{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    // Deliberately not `strict` — the goal is catching schema drift in the
    // Card/CardSet shape (see types/card.ts), not fully typing every helper
    // in scripts/*.mjs. noImplicitAny off keeps this from flooding
    // unrelated parameters with errors.
    "noImplicitAny": false
  },
  "include": ["scripts/**/*.mjs", "types/**/*.ts"]
}
